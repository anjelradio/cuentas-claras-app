# Entorno de ejecución: development, test o production.
APP_ENV=development
APP_NAME=cuentas-claras-server

# Reservada para Neon/PostgreSQL. No se usa hasta que exista un módulo persistente.
DATABASE_URL=postgresql+psycopg://user:password@host/database?sslmode=require

# Lista separada por comas; no se permiten comodines.
CORS_ORIGINS=http://localhost:3000

# Valores públicos de ejemplo para validar JWT emitidos por Better Auth.
AUTH_JWKS_URL=https://auth.example.test/api/auth/jwks
AUTH_JWT_ISSUER=http://localhost:3000
# Opcional: dejar vacío en entornos de prueba si no hay audiencia configurada.
AUTH_JWT_AUDIENCE=

# Días de expiración para las invitaciones a los eventos.
INVITATION_EXPIRE_DAYS=10

# Cloudinary: secretos exclusivos del backend; nunca exponer al navegador.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_QR_FOLDER=cuentas-claras/qr
